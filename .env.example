NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Optional: enables confirmed owner creation and cleanup through the Admin API.
# Without it, onboarding uses public Supabase Auth signup plus the secured RPC.
# Never prefix this key with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_BROWSER_KEY
# Optional: restaurant opened by the root URL. If omitted, the first active
# onboarding template or active restaurant is selected automatically.
NEXT_PUBLIC_DEFAULT_RESTAURANT_SLUG=restaurant-slug
# Generate these with: npm.cmd run vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:contact@antoria.ro
